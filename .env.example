# ==============================================================================
# SS VASTRA - Environment Configuration & Secrets Reference
# ==============================================================================

# 1. POSTGRESQL DATABASE (Neon / Supabase / Vercel Postgres)
# ------------------------------------------------------------------------------
# Set your PostgreSQL connection string with SSL enabled:
# Example for Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Example for Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# Optional alternative connection aliases:
# NEON_DATABASE_URL="postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require"
# SUPABASE_DATABASE_URL="postgresql://postgres:password@db.project.supabase.co:5432/postgres"

# 2. CLOUD MEDIA STORAGE (Cloudinary OR Supabase Storage)
# ------------------------------------------------------------------------------
# Option A: Cloudinary (Recommended for image transforms & CDN delivery)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
# Or provide the full connection URL:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Option B: Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_STORAGE_BUCKET="products"

# 3. SS VASTRA ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="subhashmeena3111@gmail.com"
SUPER_ADMIN_PASSWORD="your-strong-super-admin-password"
ADMIN_MASTER_PASSWORD="your-master-emergency-password"
JWT_SECRET="your-256-bit-secret-key-change-in-production-min-32-chars"
ADMIN_REQUIRE_OTP="false"
EMAIL_SERVICE_KEY="your-resend-or-smtp-service-key"
EMAIL_FROM="orders@ssvastra.com"

# 4. RAZORPAY PAYMENT GATEWAY (Live / Sandbox)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# 5. THIRD PARTY & INTEGRATIONS
# ------------------------------------------------------------------------------
# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY="AIzaSyBBPw5H_jZpEaM2b9k_IJr8f0SSEqm3C5c"

# GEMINI_API_KEY: Optional for AI assistant features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this store is hosted
APP_URL="https://ssvastra.com"
